# Copy this file to .env and fill in your own values. Never commit .env.
# On Render, add these under the service's Environment tab instead.

# Connection string for a MongoDB database you control (for example a free Atlas cluster).
# The database name in the path (here: savage-auth) is where users and messages are stored.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/savage-auth?retryWrites=true&w=majority

# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=<long-random-string>
